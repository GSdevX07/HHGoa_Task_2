# HH Goa 2026 Task 2 — Environment Variables
# Copy this file to backend/.env and fill in your API keys.
# backend/.env is gitignored and will NOT be committed.

# ── 1. Speech-to-Text Providers ───────────────────────────────────────────────
# At least one STT key is required for voice queries.
# Text queries (/api/query/text) work without STT keys.

# Sarvam AI — PRIMARY (required by task)
# Get key: https://console.sarvam.ai
SARVAM_API_KEY=YOUR_API_KEY_HERE

# ElevenLabs Scribe — ALTERNATE
# Get key: https://elevenlabs.io/speech-to-text
ELEVENLABS_API_KEY=YOUR_API_KEY_HERE

# Which provider to use first: "sarvam" or "elevenlabs"
STT_PROVIDER=sarvam

# ── 2. LLM Generation ─────────────────────────────────────────────────────────
# At least one LLM key is required for answer generation.
# Without a key, the pipeline returns refusal for all queries.

# Groq — PRIMARY (free tier, very fast)
# Get key: https://console.groq.com
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# OpenAI — FALLBACK
OPENAI_API_KEY=

# ── 3. HuggingFace (for download_dataset.py) ──────────────────────────────────
# Optional — only needed if MSMARCO-XI requires authentication.
# Get token: https://huggingface.co/settings/tokens
HF_TOKEN=YOUR_HF_TOKEN_HERE

# ── 4. Retrieval Configuration ────────────────────────────────────────────────
# Embedding model for dense retrieval (default: all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Reranker model (default: BAAI/bge-reranker-v2-m3)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Set to "false" to disable reranker (faster but less accurate)
RERANKER_ENABLED=true

# Number of candidates from hybrid retrieval (before reranking)
RETRIEVAL_CANDIDATE_POOL=20

# Final number of passages returned to LLM
RERANKER_TOP_K=3

# Minimum retrieval confidence threshold (0.0-1.0)
RETRIEVAL_THRESHOLD=0.15

# ── 5. Latency Configuration ──────────────────────────────────────────────────
LATENCY_TARGET_MS=200

# LLM request timeouts (seconds)
GROQ_TIMEOUT_S=6.0
OPENAI_TIMEOUT_S=8.0
