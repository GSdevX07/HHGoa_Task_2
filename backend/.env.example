# HH Goa 2026 Task 2: Voice-Enabled RAG System Environment Variables

# ── 1. Speech-to-Text Providers ───────────────────────────────
# Option A: Sarvam AI STT API Key (https://api.sarvam.ai)
SARVAM_API_KEY=

# Option B: ElevenLabs Speech-to-Text API Key (https://elevenlabs.io)
ELEVENLABS_API_KEY=

# STT Provider Preference: "sarvam" or "elevenlabs"
STT_PROVIDER=sarvam

# ── 2. LLM Synthesis Models (Optional) ────────────────────────
# Groq API Key for ultra-fast Llama-3.3-70B inference
GROQ_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# ── 3. Performance & Target SLA Settings ─────────────────────
# Maximum target latency SLA in milliseconds (default: 200)
LATENCY_TARGET_MS=200
